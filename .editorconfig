root = true

[*.{kt,kts}]
indent_size = 4
max_line_length = 140
insert_final_newline = true
# Jetpack Compose composables conventionally use PascalCase (e.g. PricingScreen); this is the
# documented ktlint escape hatch instead of fighting the Kotlin function-naming rule project-wide.
ktlint_function_naming_ignore_when_annotated_with = Composable

