# Public project identifier only; never put credentials or ID tokens in this file.
FIREBASE_PROJECT_ID=replace-with-firebase-project-id
PRICING_ARTIFACT_DIR=/opt/pricing/artifacts
PRICING_TARIFF_CSV=/opt/pricing/tariff.csv
# SHA-256 from an independently reviewed release; do not derive this from an unknown mounted bundle.
PRICING_ARTIFACT_MANIFEST_SHA256=replace-with-reviewed-64-character-sha256
