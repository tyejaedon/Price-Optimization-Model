<?xml version="1.0" encoding="utf-8"?>
<!-- No mentor description text, tokens or credentials are ever auto-backed up (data safety guardrail). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>

